import os
import sys
import sqlite3
import urllib.parse

import pg8000.dbapi

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
SQLITE_PATH = os.path.join(BASE_DIR, "moneytrack.db")

TABLES = [
    "users",
    "accounts",
    "budgets",
    "transactions",
    "debts",
    "investments",
    "investment_history",
    "recurring_payments",
    "financial_goals",
]

SCHEMA = """
CREATE TABLE IF NOT EXISTS users (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    phone TEXT UNIQUE,
    email TEXT UNIQUE,
    password TEXT NOT NULL,
    plan TEXT DEFAULT 'free',
    expires TEXT,
    trial_started TEXT
);
CREATE TABLE IF NOT EXISTS transactions (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    kind TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    category TEXT NOT NULL,
    note TEXT DEFAULT '',
    created TEXT NOT NULL,
    account_id BIGINT
);
CREATE TABLE IF NOT EXISTS accounts (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    balance DOUBLE PRECISION DEFAULT 0
);
CREATE TABLE IF NOT EXISTS budgets (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    category TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    UNIQUE(user_id, category)
);
CREATE TABLE IF NOT EXISTS debts (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    direction TEXT NOT NULL,
    person TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    paid_amount DOUBLE PRECISION DEFAULT 0,
    note TEXT DEFAULT '',
    created TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS investments (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    asset_type TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    current_value DOUBLE PRECISION DEFAULT 0,
    note TEXT DEFAULT '',
    created TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS investment_history (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    investment_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    current_value DOUBLE PRECISION NOT NULL,
    recorded_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS recurring_payments (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    category TEXT NOT NULL,
    frequency TEXT NOT NULL,
    next_date TEXT NOT NULL,
    note TEXT DEFAULT '',
    active INTEGER DEFAULT 1,
    created TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS financial_goals (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    target_amount DOUBLE PRECISION NOT NULL,
    saved_amount DOUBLE PRECISION DEFAULT 0,
    target_date TEXT DEFAULT '',
    created TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP::text)
);
"""


def connect_postgres():
    url = os.environ.get("DATABASE_URL", "").strip()
    if not url:
        raise RuntimeError("DATABASE_URL не задан.")

    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("postgres", "postgresql"):
        raise RuntimeError("DATABASE_URL должен быть PostgreSQL URL.")

    if not parsed.hostname or not parsed.username or not parsed.path.strip("/"):
        raise RuntimeError("DATABASE_URL имеет неполный формат.")

    return pg8000.dbapi.connect(
        user=urllib.parse.unquote(parsed.username),
        password=urllib.parse.unquote(parsed.password or ""),
        host=parsed.hostname,
        port=parsed.port or 5432,
        database=urllib.parse.unquote(parsed.path.lstrip("/")),
        ssl_context=True,
        timeout=20,
    )


def main():
    if not os.path.isfile(SQLITE_PATH):
        sys.exit("ОШИБКА: moneytrack.db не найдена.")

    src = sqlite3.connect(SQLITE_PATH)
    src.row_factory = sqlite3.Row
    pg = None

    try:
        pg = connect_postgres()

        # Не допускаем повторный импорт в непустые таблицы.
        cur = pg.cursor()
        for statement in SCHEMA.split(";"):
            statement = statement.strip()
            if statement:
                cur.execute(statement)

        cur.execute("""
            SELECT table_name
            FROM information_schema.tables
            WHERE table_schema = current_schema()
        """)
        existing = {row[0] for row in cur.fetchall()}

        if existing:
            cur.execute(
                "SELECT COUNT(*) FROM users"
            ) if "users" in existing else None
            if "users" in existing:
                count = cur.fetchone()[0]
                if count:
                    raise RuntimeError(
                        "В Neon уже есть пользователи. "
                        "Автоматический импорт остановлен, "
                        "чтобы не смешивать аккаунты."
                    )

        for table in TABLES:
            if table in existing:
                cur.execute(
                    f'SELECT COUNT(*) FROM "{table}"'
                )
                if cur.fetchone()[0]:
                    raise RuntimeError(
                        f"Таблица {table} уже содержит данные. "
                        "Импорт остановлен без смешивания записей."
                    )

    # Импорт всех таблиц в одной транзакции.
    cur = pg.cursor()
        for table in TABLES:
            rows = src.execute(
                f'SELECT * FROM "{table}" ORDER BY id'
            ).fetchall()

            if not rows:
                print(f"{table}: 0 записей")
                continue

            columns = [
                item[1]
                for item in src.execute(
                    f'PRAGMA table_info("{table}")'
                ).fetchall()
            ]
            column_sql = ", ".join(
                '"' + name + '"' for name in columns
            )
            placeholders = ", ".join(
                ["%s"] * len(columns)
            )
            sql = (
                f'INSERT INTO "{table}" ({column_sql}) '
                f"VALUES ({placeholders})"
            )

            for row in rows:
                cur.execute(
                    sql,
                    tuple(row[name] for name in columns),
                )

            print(f"{table}: перенесено {len(rows)}")

        # Сдвигаем генераторы ID за максимальные перенесённые ID.
        for table in TABLES:
            cur.execute("""
                SELECT setval(
                    pg_get_serial_sequence(%s, 'id'),
                    GREATEST(COALESCE(MAX(id), 1), 1),
                    COALESCE(MAX(id), 0) > 0
                )
                FROM """ + '"' + table + '"', (table,))

    pg.commit()
    print("Перенос завершён. Локальная SQLite-база не изменялась.")

    except Exception as exc:
        if pg is not None:
            pg.rollback()
        print(
            "МИГРАЦИЯ ОСТАНОВЛЕНА; транзакция отменена.",
            type(exc).__name__,
            str(exc),
        )
        sys.exit(1)
    finally:
        src.close()
        if pg is not None:
            pg.close()


if __name__ == "__main__":
    main()
