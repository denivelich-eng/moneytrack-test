
import os
import sqlite3
import sys
import pg8000.dbapi


SQLITE_PATH = os.path.join(os.path.dirname(__file__), "moneytrack.db")

TABLES = [
    "users",
    "accounts",
    "budgets",
    "transactions",
    "debts",
    "investments",
    "investment_history",
    "recurring_payments",
    "financial_goals",
]

SCHEMA = """
CREATE TABLE IF NOT EXISTS users (
    id BIGINT PRIMARY KEY,
    phone TEXT UNIQUE,
    email TEXT UNIQUE,
    password TEXT NOT NULL,
    plan TEXT DEFAULT 'free',
    expires TEXT,
    trial_started TEXT
);

CREATE TABLE IF NOT EXISTS transactions (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    kind TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    category TEXT NOT NULL,
    note TEXT DEFAULT '',
    created TEXT NOT NULL,
    account_id BIGINT
);

CREATE TABLE IF NOT EXISTS accounts (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    balance DOUBLE PRECISION DEFAULT 0
);

CREATE TABLE IF NOT EXISTS budgets (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    category TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    UNIQUE(user_id, category)
);

CREATE TABLE IF NOT EXISTS debts (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    direction TEXT NOT NULL,
    person TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    paid_amount DOUBLE PRECISION DEFAULT 0,
    note TEXT DEFAULT '',
    created TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS investments (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    asset_type TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    current_value DOUBLE PRECISION DEFAULT 0,
    note TEXT DEFAULT '',
    created TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS investment_history (
    id BIGINT PRIMARY KEY,
    investment_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    current_value DOUBLE PRECISION NOT NULL,
    recorded_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS recurring_payments (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    amount DOUBLE PRECISION NOT NULL,
    category TEXT NOT NULL,
    frequency TEXT NOT NULL,
    next_date TEXT NOT NULL,
    note TEXT DEFAULT '',
    active INTEGER DEFAULT 1,
    created TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS financial_goals (
    id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    target_amount DOUBLE PRECISION NOT NULL,
    saved_amount DOUBLE PRECISION DEFAULT 0,
    target_date TEXT DEFAULT '',
    created TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
"""


def main():
    url = os.environ.get("DATABASE_URL", "").strip()
    if not url:
        sys.exit(
            "ОШИБКА: DATABASE_URL не задан. "
            "Ничего не перенесено."
        )

    if not os.path.isfile(SQLITE_PATH):
        sys.exit("ОШИБКА: локальная база moneytrack.db не найдена.")

    src = sqlite3.connect(SQLITE_PATH)
    src.row_factory = sqlite3.Row

    try:
        pg = pg8000.dbapi.connect(
            user=os.environ.get("NEON_USER"),
            password=os.environ.get("NEON_PASSWORD"),
            host=os.environ.get("NEON_HOST"),
            port=int(os.environ.get("NEON_PORT", "5432")),
            database=os.environ.get("NEON_DATABASE"),
            ssl_context=True,
        )
    except Exception as exc:
        src.close()
        sys.exit(
            "Не удалось подключиться к PostgreSQL. "
            "Проверь настройки подключения в Termux. "
            f"Тип ошибки: {type(exc).__name__}"
        )

    try:
        with pg.cursor() as cur:
            cur.execute(SCHEMA)
        pg.commit()

        # Сначала проверяем конфликты по ID, телефону и email.
        # При конфликте миграция останавливается до импорта записей.
        with pg.cursor() as cur:
            for row in src.execute("SELECT * FROM users ORDER BY id"):
                cur.execute(
                    "SELECT id, phone, email FROM users "
                    "WHERE id = %s OR "
                    "(phone IS NOT NULL AND phone = %s) OR "
                    "(email IS NOT NULL AND LOWER(email) = LOWER(%s))",
                    (row["id"], row["phone"], row["email"]),
                )
                conflicts = cur.fetchall()
                if conflicts:
                    raise RuntimeError(
                        "Конфликт аккаунта из локальной базы: "
                        f"local_id={row['id']}. "
                        "Данные не перезаписаны. "
                        "Нужно отдельно сопоставить аккаунты."
                    )

        # Импортируем только после проверки всех пользователей.
        with pg.cursor() as cur:
            for table in TABLES:
                rows = src.execute(f"SELECT * FROM {table}").fetchall()
                if not rows:
                    print(f"{table}: 0 записей")
                    continue

                columns = [column[1] for column in
                           src.execute(f"PRAGMA table_info({table})")]

                placeholders = ", ".join(["%s"] * len(columns))
                column_sql = ", ".join(f'"{c}"' for c in columns)
                insert_sql = (
                    f'INSERT INTO "{table}" ({column_sql}) '
                    f"VALUES ({placeholders})"
                )

                for row in rows:
                    cur.execute(
                        insert_sql,
                        tuple(row[column] for column in columns),
                    )

                print(f"{table}: перенесено {len(rows)}")

        pg.commit()
        print("Перенос завершён. Данные Neon не удалялись.")

    except Exception as exc:
        pg.rollback()
        print(
            "МИГРАЦИЯ ОСТАНОВЛЕНА. Изменения текущей транзакции "
            "отменены. Тип ошибки:",
            type(exc).__name__,
        )
        print(str(exc))
        sys.exit(1)
    finally:
        src.close()
        pg.close()


if __name__ == "__main__":
    main()
