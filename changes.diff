+@app.route("/recurring/edit/<int:payment_id>", methods=["GET", "POST"])
+@login_required
+def edit_recurring(payment_id):
+    user = current_user()
+
+    if not has_access(user):
+        return redirect(url_for("plans"))
+
+    with connect_db() as db:
+        payment = db.execute("""
+            SELECT * FROM recurring_payments
+            WHERE id=? AND user_id=? AND active=1
+        """, (payment_id, user["id"])).fetchone()
+
+    if payment is None:
+        flash("Регулярный платёж не найден.")
+        return redirect(url_for("recurring"))
+
+    if request.method == "POST":
+        name = request.form.get("name", "").strip()
+        category = request.form.get("category", "").strip()
+        frequency = request.form.get("frequency", "").strip()
+        next_date = request.form.get("next_date", "").strip()
+        note = request.form.get("note", "").strip()
+
+        try:
+            amount = float(request.form.get("amount", "0"))
+            datetime.strptime(next_date, "%Y-%m-%d")
+
+            if (
+                not name
+                or amount <= 0
+                or not category_is_valid(user["id"], "expense", category)
+                or frequency not in ("monthly", "weekly", "yearly")
+            ):
+                raise ValueError
+
+            with connect_db() as db:
+                db.execute("""
+                    UPDATE recurring_payments
+                    SET name=?, amount=?, category=?, frequency=?,
+                        next_date=?, note=?
+                    WHERE id=? AND user_id=? AND active=1
+                """, (
+                    name, amount, category, frequency, next_date,
+                    note, payment_id, user["id"]
+                ))
+
+            flash("Регулярный платёж обновлён.")
+            return redirect(url_for("recurring"))
+
+        except (ValueError, TypeError):
+            flash("Проверь название, сумму, категорию и дату.")
+
+    content = """
+    <div class="card">
+        <h2>Редактирование платежа</h2>
+        <form method="post">
+            <label>Название платежа</label>
+            <input name="name" maxlength="100"
+                   value="{{ payment['name'] }}" required>
+
+            <label>Сумма, ₽</label>
+            <input name="amount" type="number" min="0.01" step="0.01"
+                   value="{{ payment['amount'] }}" required>
+
+            <label>Категория</label>
+            <select name="category" required>
+                {% for c in categories %}
+                <option value="{{ c }}"
+                    {% if c == payment['category'] %}selected{% endif %}>
+                    {{ c }}
+                </option>
+                {% endfor %}
+            </select>
+
+            <label>Периодичность</label>
+            <select name="frequency" required>
+                <option value="monthly"
+                    {% if payment['frequency'] == 'monthly' %}selected{% endif %}>
+                    Каждый месяц
+                </option>
+                <option value="weekly"
+                    {% if payment['frequency'] == 'weekly' %}selected{% endif %}>
+                    Каждую неделю
+                </option>
+                <option value="yearly"
+                    {% if payment['frequency'] == 'yearly' %}selected{% endif %}>
+                    Каждый год
+                </option>
+            </select>
+
+            <label>Дата следующего платежа</label>
+            <input name="next_date" type="date"
+                   value="{{ payment['next_date'] }}" required>
+
+            <label>Примечание</label>
+            <input name="note" maxlength="500"
+                   value="{{ payment['note'] or '' }}">
+
+            <button type="submit">Сохранить изменения</button>
+        </form>
+        <a class="primary-link" href="/recurring">Отмена</a>
+    </div>
+    """
+    return page(
+        "Редактирование платежа",
+        content,
+        categories=get_user_categories(user["id"], "expense"),
+        payment=payment
+    )
+
