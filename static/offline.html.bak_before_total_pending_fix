<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f172a">
  <title>MoneyTrack — офлайн</title>
  <style>
    * { box-sizing: border-box; }

    :root {
      color-scheme: dark;
      --bg: #0b1120;
      --surface: #151f32;
      --surface-light: #1c2940;
      --border: #2a3850;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --green: #34d399;
      --red: #fb7185;
      --blue: #818cf8;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding-bottom: 24px;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      font-size: 13px;
      line-height: 1.6;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 5;
      padding: 12px 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      color: var(--text);
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    header::first-letter { color: var(--green); }

    header span {
      float: right;
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0;
    }

    main {
      width: 100%;
      max-width: 760px;
      margin: auto;
      padding: 12px 11px 28px;
    }

    section, .status {
      overflow-wrap: anywhere;
    }

    section {
      margin: 16px 0;
      padding: 15px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
      box-shadow: 0 8px 24px #00000018;
    }

    h2, h3 {
      color: var(--text);
      line-height: 1.35;
      letter-spacing: -0.3px;
    }

    h2 { margin-top: 0; font-size: 18px; }
    h3 { font-size: 15px; }

    p { color: var(--muted); }

    .status {
      margin: 10px 0;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface-light);
      color: var(--text);
    }

    label {
      display: block;
      margin: 14px 0 6px;
      color: var(--muted);
      font-weight: 600;
    }

    input, select {
      display: block;
      width: 100%;
      min-width: 0;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
      background: #0b1120;
      color: var(--text);
      font: inherit;
    }

    input:focus, select:focus {
      border-color: var(--green);
    }

    button {
      width: 100%;
      min-height: 42px;
      margin-top: 12px;
      padding: 10px 14px;
      border: 0;
      border-radius: 9px;
      background: var(--green);
      color: #052e2b;
      font: inherit;
      font-weight: 750;
      cursor: pointer;
    }

    button:active { opacity: .85; }

    #offlineFormStatus {
      overflow-wrap: anywhere;
    }

    #offlineTransactions .status strong {
      display: block;
      overflow-wrap: anywhere;
    }

    #details {
      padding: 0 4px;
      font-size: 12px;
    }

    [hidden] { display: none !important; }

    @media (max-width: 420px) {
      header { padding: 11px 12px; }
      main { padding: 10px 9px 24px; }
      section { padding: 12px; }
      header span { font-size: 10px; }
    }
  </style>
</head>
<body>
  <header>MoneyTrack <span>Офлайн-режим</span></header>
  <main>
    <div class="status" id="status">Проверяем подключение…</div>
    <div class="status" id="copyStatus">Проверяем локальную копию…</div>

    <section id="offlineEntry" hidden>
      <h2>Добавить операцию офлайн</h2>
      <form id="offlineTransactionForm">
        <label for="offlineKind">Тип операции</label>
        <select id="offlineKind" required>
          <option value="expense">Расход</option>
          <option value="income">Доход</option>
        </select>
        <label for="offlineAccount">Счёт</label>
      <select id="offlineAccount" required>
        <option value="">Загрузка счетов…</option>
      </select>

      <label for="offlineAmount">Сумма, ₽</label>
        <input id="offlineAmount" type="number" min="0.01" step="0.01"
               inputmode="decimal" required>
        <label for="offlineCategory">Категория</label>
        <select id="offlineCategory" required>
          <option value="">Выбери категорию</option>
        </select>
        <label for="offlineNote">Комментарий</label>
        <input id="offlineNote" maxlength="250" placeholder="Необязательно">
        <button type="submit">Сохранить на устройстве</button>
        <p id="offlineFormStatus" role="status"></p>
      </form>
    </section>

    <section id="financialSummary" hidden>
      <h2>Сохранённые финансы</h2>
      <div class="status" id="offlineBalance"></div>
      <div class="status" id="offlineMonth"></div>
      <div class="status" id="offlineAccounts"></div>
      <h3>Последние операции</h3>
      <div id="offlineTransactions"></div>
      <h3>Бюджеты</h3>
      <div id="offlineBudgets"></div>
      <h3>Долги</h3>
      <div id="offlineDebts"></div>
      <h3>Инвестиции</h3>
      <div id="offlineInvestments"></div>
      <h3>Регулярные платежи</h3>
      <div id="offlineRecurring"></div>
      <h3>Финансовые цели</h3>
      <div id="offlineGoals"></div>
    </section>
    <p id="details">
      Эта страница доступна без интернета. Финансовые данные доступны
      для просмотра, если ранее были сохранены на этом устройстве.
    </p>
    <button type="button" onclick="location.reload()">Повторить проверку</button>
  </main>
  <script src="/static/offline-db.js"></script>
  <script src="/static/offline-sync.js"></script>
  <script>
    const status = document.getElementById("status");
    const copyStatus = document.getElementById("copyStatus");
    const details = document.getElementById("details");

    function updateConnection() {
      if (navigator.onLine) {
        status.textContent = "Подключение к интернету есть";
        details.textContent =
          "Можно вернуться на MoneyTrack и синхронизировать данные.";
      } else {
        status.textContent = "Сейчас нет подключения к интернету";
        details.textContent =
          "Открыта офлайн-страница. Доступность финансовых данных зависит от наличия сохранённой копии.";
      }
    }

    function formatMoney(value) {
      return (Number(value) || 0).toLocaleString("ru-RU", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }) + " ₽";
    }

    function parseTransactionDate(value) {
      const m = String(value || "").match(
        /^(\d{2})\.(\d{2})\.(\d{4})(?:\s+(\d{2}):(\d{2}))?$/
      );
      if (!m) return null;
      return { year: +m[3], month: +m[2], day: +m[1] };
    }

    function renderTransactions(items) {
      const container = document.getElementById("offlineTransactions");
      container.replaceChildren();

      if (!items.length) {
        const empty = document.createElement("p");
        empty.textContent = "Сохранённых операций пока нет.";
        container.appendChild(empty);
        return;
      }

      items.slice(0, 10).forEach(function (item) {
        const card = document.createElement("div");
        card.className = "status";

        const heading = document.createElement("strong");
        const income = item.kind === "income";
        heading.textContent = (income ? "+ " : "− ") + formatMoney(item.amount);
        if (item.offline_pending) heading.textContent += " · ожидает синхронизации";
        heading.style.color = income ? "#34d399" : "#fca5a5";

        const info = document.createElement("p");
        info.style.margin = "8px 0 0";
        info.textContent = [
          item.category || "Без категории",
          item.created || "",
          item.note || ""
        ].filter(Boolean).join(" · ");

        card.appendChild(heading);
        card.appendChild(info);

        if (item.offline_pending && item.client_change_id) {
          const cancelButton = document.createElement("button");
          cancelButton.type = "button";
          cancelButton.textContent = "Отменить несинхронизированную операцию";
          cancelButton.style.background = "#fb7185";
          cancelButton.style.color = "#450a0a";
          cancelButton.addEventListener("click", function () {
            cancelPendingTransaction(item.client_change_id);
          });
          card.appendChild(cancelButton);
        }

        container.appendChild(card);
      });
    }

    async function cancelPendingTransaction(clientId) {
      if (navigator.onLine) {
        alert("Для безопасной отмены сначала отключи интернет.");
        return;
      }

      const userId = localStorage.getItem("moneytrack-offline-user-id");
      const db = window.MoneyTrackOfflineDB;

      if (!userId || !db || !clientId) {
        alert("Не удалось определить операцию.");
        return;
      }

      if (!confirm("Отменить эту операцию? Она будет удалена с устройства и не попадёт на сервер.")) {
        return;
      }

      try {
        const pending = await db.getPendingChanges(userId);
        const row = pending.find(function (entry) {
          return entry.change &&
            entry.change.client_change_id === clientId;
        });

        if (!row) {
          alert("Операция уже отсутствует в очереди. Обнови данные при подключении к интернету.");
          return;
        }

        const snapshot = await db.getSnapshot(userId);
        if (!snapshot || !snapshot.data) {
          alert("Локальная копия не найдена. Очередь сохранена без изменений.");
          return;
        }

        await db.removePendingChange(row.id);

        snapshot.data.transactions = (
          Array.isArray(snapshot.data.transactions)
            ? snapshot.data.transactions
            : []
        ).filter(function (item) {
          return item.client_change_id !== clientId;
        });

        await db.saveSnapshot(userId, snapshot.data);
        await updateSavedCopy();
      } catch (error) {
        alert("Не удалось отменить операцию: " + (error.message || "ошибка хранилища"));
      }
    }


    const OFFLINE_DEFAULT_CATEGORIES = {
      income: [
        "Зарплата", "Дивиденды", "Проценты", "Подработка",
        "Подарки", "Возврат долга", "Другое"
      ],
      expense: [
        "Продукты", "Транспорт", "Жильё", "Коммунальные услуги",
        "Телефон и интернет", "Аренда", "Развлечения",
        "Здоровье", "Другое"
      ]
    };

    async function populateOfflineCategories() {
      const select = document.getElementById("offlineCategory");
      const kind = document.getElementById("offlineKind").value;
      if (!select) return;

      const categories = [...(OFFLINE_DEFAULT_CATEGORIES[kind] || [])];
      const userId = localStorage.getItem("moneytrack-offline-user-id");
      const db = window.MoneyTrackOfflineDB;

      if (userId && db) {
        try {
          const snapshot = await db.getSnapshot(userId);
          const custom = snapshot?.data?.user_categories;
          if (Array.isArray(custom)) {
            custom.forEach(item => {
              if (item.kind === kind && item.name &&
                  !categories.includes(item.name)) {
                categories.push(item.name);
              }
            });
          }
        } catch (error) {
          console.warn("Не удалось загрузить пользовательские категории", error);
        }
      }

      const previous = select.value;
      select.innerHTML = "";

      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "Выбери категорию";
      select.appendChild(placeholder);

      categories.forEach(name => {
        const option = document.createElement("option");
        option.value = name;
        option.textContent = name;
        select.appendChild(option);
      });

      if (categories.includes(previous)) select.value = previous;
    }

    async function addOfflineTransaction(event) {
      event.preventDefault();
      const message = document.getElementById("offlineFormStatus");
      const userId = localStorage.getItem("moneytrack-offline-user-id");
      const db = window.MoneyTrackOfflineDB;

      if (!userId || !db) {
        message.textContent = "Нет сохранённого аккаунта. Открой MoneyTrack с интернетом и дождись сохранения локальной копии.";
        return;
      }

      const amount = Number(document.getElementById("offlineAmount").value);
      const accountId = document.getElementById("offlineAccount").value;
      const kind = document.getElementById("offlineKind").value;
      const category = document.getElementById("offlineCategory").value.trim();
      const note = document.getElementById("offlineNote").value.trim();

      if (!Number.isFinite(amount) || amount <= 0 || !category || !accountId) {
        message.textContent = "Укажи корректную сумму, категорию и счёт.";
        return;
      }

      try {
        const snapshot = await db.getSnapshot(userId);
        if (!snapshot || !snapshot.data) {
          message.textContent = "Локальная копия не найдена. Сначала открой сайт с интернетом.";
          return;
        }

        const accounts = Array.isArray(snapshot.data.accounts)
          ? snapshot.data.accounts : [];
        const selectedAccount = accounts.find(
          account => String(account.id) === String(accountId)
        );

        if (!selectedAccount) {
          message.textContent = "Выбранный счёт не найден в локальной копии. Подключись к интернету и обнови данные.";
          return;
        }

        if (kind !== "income" && kind !== "expense") {
          message.textContent = "Выбери корректный тип операции.";
          return;
        }

        // Учитываем операции, сохранённые офлайн и ещё не подтверждённые сервером.
        const pendingForAccount = (snapshot.data.transactions || []).filter(
          item => item.offline_pending &&
            String(item.account_id) === String(accountId)
        );

        const pendingChange = pendingForAccount.reduce((sum, item) => {
          const value = Number(item.amount) || 0;
          return sum + (item.kind === "income" ? value :
            item.kind === "expense" ? -value : 0);
        }, 0);

        const effectiveBalance = (Number(selectedAccount.balance) || 0)
          + pendingChange;

        if (kind === "expense" && amount > effectiveBalance) {
          message.textContent = "Недостаточно средств. Доступно с учётом несинхронизированных операций: " +
            formatMoney(Math.max(0, effectiveBalance)) + ".";
          return;
        }

        const now = new Date();
        const pad = n => String(n).padStart(2, "0");
        const created = `${pad(now.getDate())}.${pad(now.getMonth() + 1)}.${now.getFullYear()} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
        const clientId = (crypto.randomUUID
          ? crypto.randomUUID()
          : "offline-" + Date.now() + "-" + Math.random().toString(16).slice(2));

        const transaction = {
          id: clientId,
          client_change_id: clientId,
          kind, amount, category, note, created,
          account_id: Number(accountId),
          offline_pending: true
        };

        await db.enqueueChange(userId, {
          action: "create_transaction",
          client_change_id: clientId,
          transaction: transaction
        });

        document.getElementById("offlineEntry").hidden = false;
        const data = snapshot.data;
        if (!Array.isArray(data.transactions)) data.transactions = [];
        data.transactions.unshift(transaction);
        await db.saveSnapshot(userId, data);

        document.getElementById("offlineTransactionForm").reset();
        await populateOfflineCategories();
        await populateOfflineAccounts();
        message.textContent = "Сохранено на устройстве. На сервер ещё не отправлено.";
        await updateSavedCopy();
      } catch (error) {
        message.textContent = "Не удалось сохранить операцию: " + (error.message || "ошибка хранилища");
      }
    }

    document.getElementById("offlineKind").addEventListener(
      "change", populateOfflineCategories
    );

    async function populateOfflineAccounts() {
      const select = document.getElementById("offlineAccount");
      if (!select || !window.MoneyTrackOfflineDB) return;

      const userId = localStorage.getItem("moneytrack-offline-user-id");
      if (!userId) {
        select.innerHTML = '<option value="">Нет сохранённого аккаунта</option>';
        return;
      }

      const snapshot = await window.MoneyTrackOfflineDB.getSnapshot(userId);
      const accounts = snapshot && snapshot.data && Array.isArray(snapshot.data.accounts)
        ? snapshot.data.accounts : [];

      select.innerHTML = "";
      if (!accounts.length) {
        select.innerHTML = '<option value="">Нет сохранённых счетов</option>';
        return;
      }

      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "Выбери счёт";
      select.appendChild(placeholder);

      const transactions = Array.isArray(snapshot.data.transactions)
        ? snapshot.data.transactions : [];

      accounts.forEach(account => {
        const pendingChange = transactions
          .filter(item => item.offline_pending &&
            String(item.account_id) === String(account.id))
          .reduce((sum, item) => {
            const amount = Number(item.amount) || 0;
            return sum + (item.kind === "income" ? amount :
              item.kind === "expense" ? -amount : 0);
          }, 0);

        const effectiveBalance = (Number(account.balance) || 0) + pendingChange;
        const option = document.createElement("option");
        option.value = String(account.id);
        option.textContent = (account.name || account.title || ("Счёт #" + account.id))
          + " · " + effectiveBalance.toLocaleString("ru-RU", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) + " ₽";
        select.appendChild(option);
      });
    }



    async function verifyOfflineAccountAccess() {
      const savedUserId = localStorage.getItem("moneytrack-offline-user-id");
      const summary = document.getElementById("financialSummary");
      const entry = document.getElementById("offlineEntry");

      function deny(message) {
        summary.hidden = true;
        entry.hidden = true;
        copyStatus.textContent = message;
        details.textContent = "Локальная копия и очередь операций сохранены.";
        return false;
      }

      if (!savedUserId) {
        return deny("Локальная копия аккаунта не найдена.");
      }

      if (!navigator.onLine) {
        entry.hidden = false;
        return true;
      }

      try {
        const response = await fetch("/api/offline/snapshot", {
          credentials: "same-origin",
          cache: "no-store"
        });

        if (response.status === 401 || response.status === 403 ||
            response.redirected || !response.ok) {
          return deny("Войдите в аккаунт, которому принадлежит локальная копия.");
        }

        const result = await response.json();
        if (!result || result.ok !== true || result.user_id == null) {
          return deny("Не удалось подтвердить аккаунт. Данные сохранены.");
        }

        if (String(result.user_id) !== String(savedUserId)) {
          return deny("Локальная копия принадлежит другому аккаунту. Данные сохранены.");
        }

        entry.hidden = false;
        return true;
      } catch (_) {
        // При сбое запроса разрешаем локальный доступ только если
        // браузер действительно сообщает об отсутствии сети.
        if (!navigator.onLine) {
          entry.hidden = false;
          return true;
        }

        return deny(
          "Не удалось проверить аккаунт из-за ошибки соединения. Данные сохранены."
        );
      }
    }

    async function updateSavedCopy() {
      try {
        const userId = localStorage.getItem("moneytrack-offline-user-id");

        if (!userId || !window.MoneyTrackOfflineDB) {
          copyStatus.textContent = "Локальная копия аккаунта не найдена";
          return;
        }

        const snapshot = await window.MoneyTrackOfflineDB.getSnapshot(userId);
        if (!snapshot || !snapshot.data) {
          copyStatus.textContent = "Для выбранного аккаунта нет сохранённой копии";
          return;
        }

        const data = snapshot.data;
        const accounts = Array.isArray(data.accounts) ? data.accounts : [];
        const transactions = Array.isArray(data.transactions) ? data.transactions : [];
        const savedDate = new Date(snapshot.savedAt);
        const dateText = Number.isNaN(savedDate.getTime())
          ? "дата неизвестна" : savedDate.toLocaleString("ru-RU");

        copyStatus.textContent = "Локальная копия найдена · сохранена: " +
          dateText + " · разделов: " + Object.keys(data).length;

        const accountTotal = accounts.reduce(function (sum, account) {
          return sum + (Number(account.balance) || 0);
        }, 0);

        const unassigned = transactions.filter(function (item) {
          return item.account_id === null || item.account_id === undefined;
        });

        const unassignedIncome = unassigned.reduce(function (sum, item) {
          return sum + (item.kind === "income" ? Number(item.amount) || 0 : 0);
        }, 0);

        const unassignedExpense = unassigned.reduce(function (sum, item) {
          return sum + (item.kind === "expense" ? Number(item.amount) || 0 : 0);
        }, 0);

        const balance = accountTotal + unassignedIncome - unassignedExpense;
        const now = new Date();
        let monthIncome = 0;
        let monthExpense = 0;

        transactions.forEach(function (item) {
          const d = parseTransactionDate(item.created);
          if (!d || d.year !== now.getFullYear() ||
              d.month !== now.getMonth() + 1) return;

          const amount = Number(item.amount) || 0;
          if (item.kind === "income") monthIncome += amount;
          if (item.kind === "expense") monthExpense += amount;
        });

        document.getElementById("offlineBalance").textContent =
          "Общий баланс: " + formatMoney(balance);
        document.getElementById("offlineMonth").textContent =
          "За текущий месяц — доходы: " + formatMoney(monthIncome) +
          "; расходы: " + formatMoney(monthExpense);
        document.getElementById("offlineAccounts").textContent =
          "Счетов: " + accounts.length +
          " · Операций в копии: " + transactions.length;

        renderTransactions(transactions);

        function renderOfflineList(id, items, fields, emptyText) {
          const container = document.getElementById(id);
          container.replaceChildren();
          if (!Array.isArray(items) || items.length === 0) {
            container.textContent = emptyText;
            return;
          }
          items.forEach(function (item) {
            const card = document.createElement("div");
            card.className = "status";
            fields.forEach(function (field) {
              const line = document.createElement("div");
              const value = item[field.key];
              line.textContent = field.label + ": " +
                (field.money ? formatMoney(value) :
                  (value === null || value === undefined || value === ""
                    ? "—" : String(value)));
              card.appendChild(line);
            });
            container.appendChild(card);
          });
        }

        renderOfflineList("offlineBudgets", data.budgets, [
          {key: "category", label: "Категория"},
          {key: "amount", label: "Лимит", money: true}
        ], "Нет сохранённых бюджетов");

        renderOfflineList("offlineDebts", data.debts, [
          {key: "direction", label: "Тип"},
          {key: "person", label: "Человек"},
          {key: "amount", label: "Сумма", money: true},
          {key: "paid_amount", label: "Оплачено", money: true},
          {key: "note", label: "Комментарий"}
        ], "Нет сохранённых долгов");

        renderOfflineList("offlineInvestments", data.investments, [
          {key: "name", label: "Актив"},
          {key: "asset_type", label: "Тип"},
          {key: "amount", label: "Вложено", money: true},
          {key: "current_value", label: "Текущая стоимость", money: true},
          {key: "note", label: "Комментарий"}
        ], "Нет сохранённых инвестиций");

        renderOfflineList("offlineRecurring", data.recurring_payments, [
          {key: "name", label: "Платёж"},
          {key: "amount", label: "Сумма", money: true},
          {key: "category", label: "Категория"},
          {key: "frequency", label: "Периодичность"},
          {key: "next_date", label: "Следующая дата"},
          {key: "active", label: "Активен"}
        ], "Нет сохранённых регулярных платежей");

        renderOfflineList("offlineGoals", data.financial_goals, [
          {key: "name", label: "Цель"},
          {key: "target_amount", label: "Нужно", money: true},
          {key: "saved_amount", label: "Накоплено", money: true},
          {key: "target_date", label: "Срок"}
        ], "Нет сохранённых финансовых целей");

        document.getElementById("financialSummary").hidden = false;
        details.textContent = "Показаны данные из локальной копии на устройстве. " +
          "Они могут быть неактуальными, если после сохранения были изменения.";
      } catch (_) {
        copyStatus.textContent = "Не удалось прочитать локальную копию";
      }
    }

async function guardedAddOfflineTransaction(event) {
      if (!(await verifyOfflineAccountAccess())) {
        event.preventDefault();
        document.getElementById("offlineFormStatus").textContent =
          "Не удалось подтвердить доступ к этому аккаунту.";
        return;
      }
      await addOfflineTransaction(event);
    }

    async function initializeOfflinePage() {
      if (!(await verifyOfflineAccountAccess())) return;
      await populateOfflineAccounts();
      await populateOfflineCategories();
      await updateSavedCopy();
    }

    window.addEventListener("online", async () => {
      updateConnection();
      await initializeOfflinePage();
    });
    window.addEventListener("offline", updateConnection);
    document.getElementById("offlineTransactionForm")
      .addEventListener("submit", guardedAddOfflineTransaction);

    updateConnection();
    initializeOfflinePage().catch((error) => {
      console.error(error);
      document.getElementById("copyStatus").textContent =
        "Не удалось загрузить локальную копию.";
    });
  </script>
</body>
</html>
